<Window x:Class="MySSH.Views.ImportSshConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入 SSH config"
        Width="760"
        Height="500"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="选择要导入的 Host"
                       FontSize="18"
                       FontWeight="SemiBold"
                       DockPanel.Dock="Left"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="全选" Click="SelectAll_Click"/>
                <Button Content="全不选" Click="SelectNone_Click"/>
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="44"/>
                <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="1*"/>
                <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="1.4*"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="0.45*"/>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="0.7*"/>
                <DataGridTextColumn Header="IdentityFile" Binding="{Binding IdentityFile}" Width="1.6*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="80"/>
            <Button Content="导入" Click="Import_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
