<Window x:Class="MySSH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MySSH.Views"
        Title="My SSH"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <views:EqualsToVisibilityConverter x:Key="SectionVisibility"/>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:InverseBoolConverter x:Key="InverseBool"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="NavListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E5EDF8"/>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#D7E0EF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B2A41"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,14">
                    <TextBlock Text="My SSH"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Windows server security"
                               Foreground="#9FB0C7"
                               FontSize="12"
                               Margin="1,3,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusText}"
                           Foreground="#9FB0C7"
                           TextWrapping="Wrap"
                           Margin="18"
                           FontSize="12"/>

                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemContainerStyle="{StaticResource NavItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=主页}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="主页" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="管理 SSH 连接资料、服务器静态信息和密钥接管流程。"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <Grid Visibility="{Binding HasNoServers, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Width="560"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="还没有服务器"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="#172033"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="从新增、导入或密钥接管开始。"
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,18"/>
                                <UniformGrid Columns="3">
                                    <Button Content="新增服务器"
                                            Command="{Binding AddServerCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Button Content="导入 SSH config"
                                            Command="{Binding ImportSshConfigCommand}"/>
                                    <Button Content="服务器密钥接管"
                                            Command="{Binding StartKeyWorkbenchCommand}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding HasServers, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="3">
                                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White" Padding="14" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="SSH 连接" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding TerminalSessions.Count, StringFormat=活动终端 {0} 个}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,10"/>
                                        <Button Content="打开终端" Command="{Binding OpenTerminalCommand}"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White" Padding="14" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="服务器信息管理" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Servers.Count, StringFormat=已保存 {0} 台服务器}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,10"/>
                                        <Button Content="查看服务器"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="服务器信息"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="服务器密钥管理" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="接管、验证、轮换和禁用密码登录。" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,10"/>
                                        <Button Content="进入工作台"
                                                Command="{Binding NavigateCommand}"
                                                CommandParameter="服务器密钥"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <DataGrid Grid.Row="1"
                                      Margin="0,18,0,0"
                                      ItemsSource="{Binding FilteredServers}"
                                      SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Host" Binding="{Binding Endpoint}" Width="1.4*"/>
                                    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Tags" Binding="{Binding TagsText}" Width="1.1*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding LastConnectionStatus}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=服务器信息}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="服务器信息" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="保存连接资料、标签、备注和静态机器配置。" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="新增" Command="{Binding AddServerCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="导入 SSH config" Command="{Binding ImportSshConfigCommand}"/>
                            <Button Content="编辑" Command="{Binding EditServerCommand}"/>
                            <Button Content="删除" Command="{Binding DeleteServerCommand}"/>
                            <Button Content="测试连接" Command="{Binding TestConnectionCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBox Width="260"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索 alias、host、user 或标签"/>
                            <ComboBox Width="170"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding Tags}"
                                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding FilteredServers}"
                                  SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="1*"/>
                                <DataGridTextColumn Header="Host" Binding="{Binding Endpoint}" Width="1.25*"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="0.7*"/>
                                <DataGridTextColumn Header="Key" Binding="{Binding KeyPath}" Width="1.35*"/>
                                <DataGridTextColumn Header="Tags" Binding="{Binding TagsText}" Width="0.9*"/>
                                <DataGridTextColumn Header="OS" Binding="{Binding Machine.Os}" Width="1*"/>
                                <DataGridTextColumn Header="CPU" Binding="{Binding Machine.CpuCores}" Width="0.45*"/>
                                <DataGridTextColumn Header="Memory" Binding="{Binding Machine.MemoryTotal}" Width="0.65*"/>
                                <DataGridTextColumn Header="Disk" Binding="{Binding Machine.DiskTotal}" Width="0.55*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding LastConnectionStatus}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=SSH 连接}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="SSH 连接" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="多标签终端、复制粘贴、断开重连和会话日志开关。" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="打开" Command="{Binding OpenTerminalCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="关闭标签" Command="{Binding CloseTerminalCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="服务器"
                                           FontWeight="SemiBold"
                                           Margin="10"/>
                                <ListBox ItemsSource="{Binding Servers}"
                                         SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                                         BorderThickness="0"
                                         DisplayMemberPath="Alias"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White">
                            <Grid>
                                <TextBlock Text="没有打开的终端"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Visibility="{Binding HasTerminalSessions, Converter={StaticResource InverseBoolToVisibility}}"/>

                                <TabControl ItemsSource="{Binding TerminalSessions}"
                                            SelectedItem="{Binding SelectedTerminal, Mode=TwoWay}"
                                            Visibility="{Binding HasTerminalSessions, Converter={StaticResource BoolToVisibility}}">
                                    <TabControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}"/>
                                                <TextBlock Text="{Binding Status, StringFormat={}  {0}}" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TabControl.ItemTemplate>
                                    <TabControl.ContentTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBox Text="{Binding Output}"
                                                         IsReadOnly="True"
                                                         FontFamily="Consolas"
                                                         FontSize="13"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         VerticalScrollBarVisibility="Auto"
                                                         AcceptsReturn="True"
                                                         TextWrapping="NoWrap"
                                                         Background="#0B1220"
                                                         Foreground="#E5EDF8"
                                                         BorderThickness="0"
                                                         Padding="10"/>
                                                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                                    <CheckBox Content="会话日志"
                                                              IsChecked="{Binding SessionLoggingEnabled}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"/>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="发送"
                                                            Command="{Binding SendInputCommand}"
                                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="重连"
                                                            Command="{Binding ReconnectCommand}"/>
                                                    <TextBox Text="{Binding PendingInput, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="Consolas"
                                                             MinHeight="32"/>
                                                </DockPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </TabControl.ContentTemplate>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=服务器密钥}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="服务器密钥" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="单页工作台：生成本机 key、复制服务器命令、探测、验证和收尾。" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="目标服务器" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Servers}"
                                              SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                                              DisplayMemberPath="Alias"
                                              Margin="0,8,0,12"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="生成并复制脚本" Command="{Binding StartKeyWorkbenchCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                        <Button Content="轮换 key" Command="{Binding PrepareRotationCommand}"/>
                                    </UniformGrid>
                                    <Button Content="再次复制执行命令"
                                            Command="{Binding CopyBootstrapCommand}"
                                            Margin="2,10,2,10"/>
                                </StackPanel>

                                <TextBox Text="{Binding CurrentKeyOperation.BootstrapCommand}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         MinHeight="180"
                                         Visibility="{Binding HasKeyOperation, Converter={StaticResource BoolToVisibility}}"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="White" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="验证与收尾" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,8,0,8">
                                        <Button Content="探测临时端口" Command="{Binding ProbeTemporaryPortCommand}"/>
                                        <Button Content="验证临时 key" Command="{Binding VerifyTemporaryKeyCommand}"/>
                                        <Button Content="验证正式端口" Command="{Binding VerifyOfficialKeyCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                        <Button Content="关闭临时入口" Command="{Binding CloseTemporaryEntryCommand}"/>
                                    </WrapPanel>
                                    <CheckBox Content="验证成功后允许禁用密码登录"
                                              IsChecked="{Binding DisablePasswordAfterVerify}"
                                              Margin="2,2,2,8"/>
                                    <Button Content="禁用密码登录"
                                            Command="{Binding DisablePasswordLoginCommand}"
                                            HorizontalAlignment="Left"/>
                                    <Expander Header="高级细节" Margin="0,10,0,10">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="临时端口"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentKeyOperation.TemporaryPort}"/>
                                            <TextBlock Grid.Row="1" Text="Token"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentKeyOperation.MaskedToken}"/>
                                            <TextBlock Grid.Row="2" Text="私钥"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentKeyOperation.PrivateKeyPath}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Text="脚本 Release"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1">
                                                <Run Text="{Binding ScriptReleaseTag, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding ScriptDeliveryMode, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Expander>
                                </StackPanel>

                                <ListBox ItemsSource="{Binding OperationLog}"
                                         BorderBrush="{StaticResource PanelBorderBrush}"
                                         MinHeight="180"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=设置}">
                    <StackPanel Width="680" HorizontalAlignment="Left">
                        <TextBlock Text="设置" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="手动检查 My SSH 应用版本和服务器脚本 Release。" Style="{StaticResource MutedTextStyle}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="应用版本"/>
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}"/>
                            <TextBlock Grid.Row="1" Text="脚本 Release"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScriptReleaseTag}"/>
                            <TextBlock Grid.Row="2" Text="数据文件"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServerStorePath}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="操作日志"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OperationLogPath}" TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
                            <Button Content="检查应用更新" Command="{Binding CheckAppUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="检查脚本 Release" Command="{Binding CheckScriptUpdateCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <StatusBar Grid.Row="1" Background="Transparent">
                <StatusBarItem Content="{Binding StatusText}"/>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
